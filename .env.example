# Copy to .env for local runs. Placeholder values only; never commit real secrets.
NODE_ENV=development
# One listener per entry adapter; each accepts only its own credential kind.
STAFF_PORT=3000
PORTAL_PORT=3001
DROP_PORT=3002
OPERATOR_PORT=3003
HOST=127.0.0.1
# In production the operator listener binds only to the operator network's interface.
OPERATOR_HOST=127.0.0.1
# The API connects as pl_app. Placeholder password; set the real one per environment.
DATABASE_URL=postgres://pl_app:change-me@127.0.0.1:5432/partledger
DATABASE_POOL_SIZE=10
# Staff sign-in (docs/runbooks/keycloak.md). The staff app's origin; it proxies /api to STAFF_PORT.
STAFF_APP_ORIGIN=http://127.0.0.1:5173
# The region's Keycloak realm; the local container from the runbook.
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/partledger
KEYCLOAK_CLIENT_ID=partledger-api
# The partledger-api client's secret, from Keycloak (Clients > partledger-api > Credentials).
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_JWKS_COOLDOWN_SECONDS=30
# 32 random bytes, base64; encrypts server-held refresh tokens. Generate: openssl rand -base64 32
SESSION_TOKEN_KEY=
STAFF_SESSION_IDLE_TIMEOUT_MINUTES=30
STAFF_SESSION_ABSOLUTE_TIMEOUT_HOURS=10
STAFF_SESSION_REFRESH_INTERVAL_SECONDS=60
# pg-boss connects as pl_job_runner, which reaches only the job queue schema. Placeholder password.
JOBS_DATABASE_URL=postgres://pl_job_runner:change-me@127.0.0.1:5432/partledger
JOBS_DATABASE_POOL_SIZE=5
# on: this process runs job handlers and fires schedules; off: it only enqueues.
JOBS_WORKERS=on
# The supplier portal's origin; links in supplier emails open it.
PORTAL_APP_ORIGIN=http://127.0.0.1:5174
# The email port's adapter. local writes each email as a JSON file to the dev inbox below and
# sends nothing; the production provider arrives with the Canada infrastructure (U24).
EMAIL_ADAPTER=local
EMAIL_LOCAL_INBOX_DIRECTORY=local-dev/email-inbox
EMAIL_FROM_ADDRESS=notifications@partledger.invalid
# Migrations (pnpm db:migrate) connect as pl_migrator through the standard libpq variables,
# set only in the shell that runs them, never in the API's environment:
# PGHOST=127.0.0.1 PGPORT=5432 PGDATABASE=partledger PGUSER=pl_migrator PGPASSWORD=change-me pnpm db:migrate
