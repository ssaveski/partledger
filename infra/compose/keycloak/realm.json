{
  "realm": "partledger",
  "displayName": "Partledger",
  "enabled": true,
  "sslRequired": "external",
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "bruteForceStrategy": "MULTIPLE",
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxTemporaryLockouts": 0,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "eventsListeners": ["jboss-logging"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "firstBrokerLoginFlow": "first broker login",
  "identityProviders": [],
  "users": [
    {
      "username": "service-account-partledger-api-admin",
      "enabled": true,
      "serviceAccountClientId": "partledger-api-admin",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ],
  "clients": [
    {
      "clientId": "partledger-api",
      "name": "Partledger staff API",
      "description": "The API completes the authorization code flow with PKCE and keeps every token server-side.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://127.0.0.1:5173/api/v1/auth/callback", "http://localhost:5173/api/v1/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true",
        "backchannel.logout.session.required": "true",
        "post.logout.redirect.uris": "http://127.0.0.1:5173/*##http://localhost:5173/*"
      },
      "defaultClientScopes": ["basic", "acr", "profile", "email"],
      "optionalClientScopes": ["organization"],
      "protocolMappers": [
        {
          "name": "partledger-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "partledger-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "partledger tenant organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "partledger_organization",
            "jsonType.label": "JSON",
            "multivalued": "true",
            "addOrganizationId": "true",
            "addOrganizationAttributes": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "partledger-api-admin",
      "name": "Partledger API administration",
      "description": "The API's service account: second-factor resets. Keycloak's manage-users is wider; see docs/runbooks/keycloak.md.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": []
    }
  ],
  "attributes": {
    "acr.loa.map": "{\"sign-in\":1,\"step-up\":2}"
  },
  "browserFlow": "partledger browser",
  "resetCredentialsFlow": "partledger reset credentials",
  "authenticationFlows": [
    {
      "alias": "partledger browser",
      "description": "Sign-in at level 1 (a password or a customer identity provider) and step-up at level 2 (a Keycloak-held one-time code).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "partledger organization"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 40,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "partledger levels"
        }
      ]
    },
    {
      "alias": "partledger organization",
      "description": "Identity-first login for organization members.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "partledger conditional organization"
        }
      ]
    },
    {
      "alias": "partledger conditional organization",
      "description": "Runs identity-first login until the user is known.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "organization",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "partledger levels",
      "description": "The levels of authentication; acr.loa.map names them sign-in (1) and step-up (2).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "partledger level 1"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "partledger level 2"
        }
      ]
    },
    {
      "alias": "partledger level 1",
      "description": "Sign-in: a password, or a customer identity provider from the same page.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "authenticatorConfig": "partledger level 1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "partledger level 2",
      "description": "Step-up: a one-time code every time, enrolled at the first step-up.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "authenticatorConfig": "partledger level 2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "partledger post broker login",
      "description": "Runs after every login through a customer identity provider: records the sign-in level, and asks for the one-time code at step-up.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "partledger broker level 1"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "partledger broker level 2"
        }
      ]
    },
    {
      "alias": "partledger broker level 1",
      "description": "The customer identity provider counts as sign-in.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "authenticatorConfig": "partledger broker level 1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "allow-access-authenticator",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "partledger broker level 2",
      "description": "Step-up after a customer identity provider: a Keycloak-held one-time code.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "authenticatorConfig": "partledger broker level 2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "partledger reset credentials",
      "description": "Forgot-password (off: resetPasswordAllowed) resets a password-account's password only; never a second factor. Other accounts, such as SSO users, are refused.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "reset-credentials-choose-user",
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "reset-credential-email",
          "authenticatorFlow": false
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "partledger refuse reset without password account"
        },
        {
          "requirement": "REQUIRED",
          "priority": 40,
          "userSetupAllowed": false,
          "authenticator": "reset-password",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "partledger refuse reset without password account",
      "description": "An account without the password-account role, such as one of a customer identity provider, never gets a password by e-mail.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "authenticatorConfig": "partledger not a password account"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "partledger level 1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "partledger level 2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    },
    {
      "alias": "partledger broker level 1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "partledger broker level 2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    },
    {
      "alias": "partledger not a password account",
      "config": {
        "condUserRole": "password-account",
        "negate": "true"
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "partledger-api-admin",
        "roles": ["manage-users"]
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "password-account",
        "description": "A Keycloak-password account (U8 invitations). Only these may reset a password by e-mail; customer SSO accounts never hold it.",
        "composite": false,
        "clientRole": false
      }
    ]
  }
}
